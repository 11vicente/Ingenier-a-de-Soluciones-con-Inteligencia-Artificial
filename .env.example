# Copia este archivo como .env y rellena los valores con tus credenciales reales.
# El archivo .env está ignorado por git (.gitignore) para proteger tus tokens.

# Token de acceso personal de GitHub (https://github.com/settings/tokens)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL base de la API de GitHub Models
GITHUB_BASE_URL=https://models.inference.ai.azure.com

# (Opcional) URL alternativa para APIs compatibles con OpenAI
OPENAI_BASE_URL=https://models.inference.ai.azure.com

# (Opcional) Clave API de OpenAI si usas los servicios oficiales de OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opcional) Clave API de LangSmith para observabilidad
# LANGCHAIN_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=mi-proyecto
